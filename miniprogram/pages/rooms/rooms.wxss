.page { padding: 24rpx; }

.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 88rpx;
}
.search-input { flex: 1; font-size: 28rpx; }
.search-clear { color: #c0c4cc; font-size: 40rpx; padding: 0 8rpx; }

/* 快捷入口行：扫码签到（第四棒） + 我的预约（第五棒） */
.entry-row {
  display: flex;
  justify-content: flex-end;
  margin: 16rpx 0;
}
.entry-row button {
  margin: 0 0 0 16rpx;
}

.building-tabs {
  display: flex;
  margin: 24rpx 0;
  background: #eceef2;
  border-radius: 12rpx;
  padding: 6rpx;
}
.building-tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-sub);
  padding: 12rpx 0;
  border-radius: 8rpx;
}
.building-tab.active {
  background: #fff;
  color: var(--primary);
  font-weight: 600;
}

.state-tip {
  text-align: center;
  color: var(--text-sub);
  padding: 120rpx 0;
  font-size: 28rpx;
}
.retry-btn {
  display: inline-block;
  margin-top: 24rpx;
  padding: 16rpx 48rpx;
  background: var(--primary);
  color: #fff;
  border-radius: 40rpx;
}

.room-card {
  background: var(--card-bg);
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.04);
}
.room-head { display: flex; justify-content: space-between; align-items: center; }
.room-title { display: flex; align-items: baseline; }
.room-name { font-size: 32rpx; font-weight: 600; }
.room-no { margin-left: 16rpx; font-size: 24rpx; color: var(--text-sub); }
.room-status {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}
.room-status.open { color: #07c160; background: rgba(7, 193, 96, 0.12); }
.room-status.closed { color: var(--text-sub); background: #f0f1f3; }

.room-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}
.room-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.room-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f1f3;
}
.seat-avail { display: flex; align-items: baseline; }
.avail-num { font-size: 40rpx; font-weight: 700; color: #07c160; }
.avail-num.zero { color: var(--text-sub); }
.avail-label { margin-left: 12rpx; font-size: 24rpx; color: var(--text-sub); }
.room-enter { color: var(--primary); font-size: 28rpx; }
